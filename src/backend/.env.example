# Copy this file to ".env" in src/backend/ and adjust values as needed.
# All values shown are the defaults used when a variable is not set.

# --- Model / checkpoint -----------------------------------------------------
# Paths default to src/ai_model/ relative to the repo, computed automatically.
# Override only if you move the checkpoint or class list elsewhere.
# MODEL_PATH=E:/Projects/VisionTransformerPestDetection_AWS_Cloud_Project_2026/src/ai_model/ViT_best.pth
# CLASSES_PATH=E:/Projects/VisionTransformerPestDetection_AWS_Cloud_Project_2026/src/ai_model/classes.txt

MODEL_NAME=vit_base_patch16_224
NUM_CLASSES=102
MODEL_VERSION=vit-ip102-v1

# "auto" picks cuda if available, otherwise cpu. Force with "cpu" or "cuda".
DEVICE=auto

# Optional future S3 model artifact location (documentation only; unused
# by local inference). Example: s3://agrivision-pestguard-models/vit_best.pth
S3_MODEL_URI=

# --- Inference ---------------------------------------------------------------
INPUT_SIZE=224
TOP_K=5
GRADCAM_ENABLED=true

# --- Upload validation ---------------------------------------------------------
MAX_UPLOAD_MB=10

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins for the local frontend dev server.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000

# --- Metadata -------------------------------------------------------------------
APP_NAME=AgriVision PestGuard API
APP_VERSION=1.0.0
